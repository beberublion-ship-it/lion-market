function buildLocalReply(message) {
  const text = String(message || '').toLowerCase();
  const allProducts = catalog.map((product) => `${product.name} ${product.category} ${product.city}`).join(' ');

  if (!text.trim()) {
    return 'Posez une question sur nos produits, notre marketplace ou la commande.';
  }

  if (text.includes('telephone') || text.includes('smartphone') || text.includes('téléphone')) {
    return 'Nous proposons des smartphones et appareils connectés, notamment le Smartphone Android à 75 000 FCFA.';
  }

  if (text.includes('ordinateur') || text.includes('informatique') || text.includes('pc')) {
    return 'La catégorie Informatique comprend des ordinateurs portables et accessoires. Le plus populaire est l’ordinateur portable à 185 000 FCFA.';
  }

  if (text.includes('mode') || text.includes('chaussure') || text.includes('montre') || text.includes('sac')) {
    return 'La section Mode propose des chaussures, montres et accessoires tendance, avec plusieurs offres disponibles à partir de 12 000 FCFA.';
  }

  if (text.includes('maison') || text.includes('canapé') || text.includes('meuble')) {
    return 'La catégorie Maison propose des meubles et articles de confort. Le canapé confortable est proposé à 150 000 FCFA.';
  }

  if (text.includes('service') || text.includes('nettoyage')) {
    return 'Nous avons aussi des services de qualité, comme le service de nettoyage à 25 000 FCFA.';
  }

  if (text.includes('livraison') || text.includes('commande') || text.includes('achat')) {
    return 'Vous pouvez ajouter un produit au panier puis passer commande directement sur WhatsApp depuis le bouton “Commander sur WhatsApp”.';
  }

  if (text.includes('prix') || text.includes('coût') || text.includes('tarif')) {
    return 'Les prix varient selon la catégorie. Les offres actuelles vont de 12 000 FCFA à 185 000 FCFA.';
  }

  if (text.includes('yaoundé') || text.includes('douala') || text.includes('bafoussam')) {
    return `Oui, nous proposons des produits disponibles dans plusieurs villes, dont ${['Yaoundé', 'Douala', 'Bafoussam'].join(', ')}.`;
  }

  if (allProducts.toLowerCase().includes(text)) {
    return 'Nous avons plusieurs offres qui correspondent à votre recherche. Vous pouvez afficher la liste de produits sur la page d’accueil et filtrer par catégorie.';
  }

  return 'Je peux vous aider à trouver un produit, expliquer une catégorie ou guider la commande. Par exemple : “Téléphone”, “Ordinateur”, “Mode”, “Commande” ou “Prix”.';
}

