app.post('/api/chat', async (req, res) => {
  const { message, history = [] } = req.body || {};

  if (!message || !String(message).trim()) {
    return res.status(400).json({ error: 'Le message est vide.' });
  }

  const apiKey = process.env.OPENAI_API_KEY;

  if (!apiKey) {
    return res.json({
      reply: buildLocalReply(message),
      source: 'local'
    });
  }

  try {
    const client = new OpenAI({ apiKey });

    const formattedHistory = history
      .filter((item) => item && typeof item.content === 'string')
      .map((item) => ({
        role: item.role === 'user' ? 'user' : 'assistant',
        content: item.content
      }));

    const completion = await client.chat.completions.create({
      model: 'gpt-4o-mini',
      messages: [
        {
          role: 'system',
          content: 'Tu es l’assistant virtuel de LION MARKET, un marketplace camerounais. Aide les clients à trouver des produits, répondre aux questions, proposer des catégories et guider les achats. Réponds en français, de façon claire et utile.'
        },
        ...formattedHistory,
        { role: 'user', content: String(message).trim() }
      ],
      temperature: 0.7
    });

    const reply = completion.choices?.[0]?.message?.content?.trim();
    res.json({
      reply: reply || 'Je peux vous aider à trouver un produit ou à passer commande.',
      source: 'openai'
    });
  } catch (error) {
    console.error('OpenAI error:', error);
    res.status(500).json({
      error: 'Impossible de traiter votre demande pour le moment. Vérifiez la clé API OpenAI ou réessayez plus tard.',
      fallback: buildLocalReply(message)
    });
  }
});

app.get('*', (req, res) => {
  if (req.path.startsWith('/api/')) {
    return res.status(404).json({ error: 'Route introuvable.' });
  }
  res.sendFile(path.join(__dirname, 'index.html'));
});

app.listen(port, () => {
  console.log(`LION MARKET est lancé sur http://localhost:${port}`);
});

module.exports = app;
